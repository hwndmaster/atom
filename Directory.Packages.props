<Project>

<Import Project="$(MSBuildThisFileDirectory)/Atom.Build/build/PackageVersions.props"/>

  <!-- Only versions that never reach a consumer belong here; everything a shipped Atom package
       depends on lives in Atom.Build/build/PackageVersions.props so consumers inherit it.
       Re-declaring an inherited version would shadow it (NU1506). -->
  <ItemGroup>
    <!-- Source Generators — must stay in lockstep with the compiler pin;
         see RoslynCompilerVersion in Atom.Build/build/PackageVersions.props.
         Referenced with PrivateAssets="all", so they stay out of the Atom.Data.Generators package. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(RoslynCompilerVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynCompilerVersion)" />
    <PackageVersion Include="Scriban" Version="7.2.5" />

    <!-- Misc — used by Atom.UI.Forms.Demo only -->
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
  </ItemGroup>

</Project>
